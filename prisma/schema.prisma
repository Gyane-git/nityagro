
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productReviews productReview[]
  orderReturns orderReturn[]
  orderCancellations orderCancellation[]
  shippingDetails shippingDetails[]
  deliveryDetails deliveryDetails[]
  paymentDetails paymentDetails[]
  inquiry inquiry[]

}

model categories {
  id        BigInt      @id @default(autoincrement())
  categoryName  String
  slug   String?
  categoryDescription String?
  categoryImage String?
  categoryLogo  String?
  categoryBanner String?
  categoryStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}

model products {
  id        BigInt      @id @default(autoincrement())
  productCode String   @unique
  productName  String
  slug   String?
  productVariation String?
  productDescription String?
  nutritionInfo String?
  cookingInstruction String?
  storageInstruction String?
  productImage String?
  productStatus Boolean @default(true)
  actualPrice Float
  SellingPrice Float
  delivaryTargetDays BigInt?
  stockQuantity BigInt?
  availableQuantity BigInt?
  flashSale Boolean @default(false)
  specialOffer Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model cartList {
  id        BigInt      @id @default(autoincrement())
  userId BigInt
  productId BigInt
  quantity BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  product products @relation(fields: [productId], references: [id])
}

model wishlist {
  id        BigInt      @id @default(autoincrement())
  userId BigInt
  productId BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  product products @relation(fields: [productId], references: [id])
}


model orders {
  id        BigInt      @id @default(autoincrement())
  userId BigInt
  totalAmount Float
  orderStatus String?
  paymentStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model banner {
  id        BigInt      @id @default(autoincrement())
  bannerName  String
  slug   String?
  bannerDescription String?
  bannerImageforWeb String?
  bannerImageforMobile String?
  bannerStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model faqs {
  id        BigInt      @id @default(autoincrement())
  question  String
  answer   String?
  faqStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model contactSettings{
  id        BigInt      @id @default(autoincrement())
  customerName  String
  customerEmail   String?
  customerMessage String?
  customerPhone String?
  mapUrl String?
  whatsappNumber String?
  companyAddress String?
  companyEmail String?
  companyPhone String?
  facebookUrl String?
  twitterUrl String?
  instagramUrl String?
  tikTokUrl String?
  contactStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model testimonials {
  id        BigInt      @id @default(autoincrement())
  name  String
  title String?
  message String?
  image String?
  designation String?
  starRating BigInt?
  testimonialStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model popupBanner {
  id        BigInt      @id @default(autoincrement())
  popupName  String?
  popupDescription String?
  popupImage String?
  popupStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model companyInfo {
  id        BigInt      @id @default(autoincrement())
  privacyPolicy  String
  companyInfo String?
  companyDescription String?
  termConditions String?
  returnPolicy String?
  shippingPolicy String?
  companyImage String?
  companyMission String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model productReview {
  id        BigInt      @id @default(autoincrement())
  productId BigInt
  userId BigInt
  rating BigInt
  review String?
  productReviewImage String?
  reviewStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product products @relation(fields: [productId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model orderReturn {
  id        BigInt      @id @default(autoincrement())
  orderId BigInt
  userId BigInt
  reason String?
  returnImage String?
  returnStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model orderCancellation {
  id        BigInt      @id @default(autoincrement())
  orderId BigInt
  userId BigInt
  adminCancellationReason String?
  cancellationReason String?
  cancellationImage String?
  cancellationStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model newsletterSubscription {
  id        BigInt      @id @default(autoincrement())
  email String   @unique
  subscriptionStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model promoCode {
  id        BigInt      @id @default(autoincrement())
  code String   @unique
  discountPercentage Float
  validFrom DateTime
  validTo DateTime
  promoStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model shippingDetails {
  id        BigInt      @id @default(autoincrement())
  orderId BigInt
  userId BigInt
  shippingCourier String?
  trackingNumber String?
  shippingDate DateTime?
  shippingRemark String?
  shippingStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model deliveryDetails {
  id        BigInt      @id @default(autoincrement())
  orderId BigInt
  userId BigInt
  deliveryDate DateTime?
  paymentMode String?
  transactionId String?
  deliveryCourier String?
  trackingNumber String?
  deliveryStatus String?
  deliveryRemark String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model paymentDetails {
  id        BigInt      @id @default(autoincrement())
  orderId BigInt
  userId BigInt
  paymentMode String?
  paymentAmount Float?
  paymentDate DateTime?
  transactionId String?
  paymentStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model inquiry {
  id        BigInt      @id @default(autoincrement())
  name String
  email String
  phone String?
  subject String?
  message String?
  inquiryStatus Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model productImage {
  id        BigInt      @id @default(autoincrement())
  productId BigInt
  imageUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product products @relation(fields: [productId], references: [id])
}

model setShippingCost {
  id        BigInt      @id @default(autoincrement())
  minOrderAmount Float
  maxOrderAmount Float
  shippingAdress String?
  shippingMethod String?
  shippingCost Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}




